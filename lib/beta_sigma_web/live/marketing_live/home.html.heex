<!-- ============================= HERO ============================= -->
<section class="mx-auto w-full max-w-[1290px] px-5">
  <div class="border-b border-n600/40 pb-24 pt-16 lg:pb-40">
    <div class="mx-auto max-w-[1062px] text-center">
      <h1 class="mb-4 text-[44px] font-medium leading-[1.15] text-n100 sm:text-[64px] lg:text-[80px]">
        Explore Our Industries
