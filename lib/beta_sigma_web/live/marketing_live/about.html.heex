<!-- ============================= HERO ============================= -->
<section class="mx-auto w-full max-w-[1290px] px-5 pt-16">
  <div class="mb-20 max-w-[854px]">
    <h1 class="mb-4 text-[44px] font-medium leading-[1.15] text-n100 sm:text-[64px] lg:text-[80px]">
      Who We Are
    </h1>
    <p class="text-[18px] leading-[1.667]">
      BeCorp partners with exceptional people and ideas to build
      industries that solve real-world challenges. Our portfolio spans
      entertainment, agriculture, real estate and professional services,
      with each company operating independently while benefiting from the
      Group's strategic leadership, governance and
      <span class="whitespace-nowrap">shared capabilities.</span>
    </p>
  </div>

  <div class="max-h-[580px] overflow-hidden">
    <img
      src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=1400&q=80"
      alt="The BeCorp office"
      class="h-[580px] w-full object-cover"
    />
