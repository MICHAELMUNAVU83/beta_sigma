  </div>
</section>

<!-- ===================== VISION & MISSION ===================== -->
<section class="mx-auto w-full max-w-[1290px] px-5">
  <div class="grid gap-16 border-y border-n600/40 py-24 lg:grid-cols-2 lg:gap-10 lg:py-32">
