  <div class="grid grid-cols-2 gap-x-10 gap-y-14 py-20 lg:grid-cols-4">
    <div>
      <div class="mb-2 text-[32px] font-medium leading-[1.2] text-n100 sm:text-[44px] lg:text-[64px]">
        4<span class="text-accent">+</span>
      </div>
      <div class="text-2xl text-n600">Group companies</div>
    </div>
    <div>
      <div class="mb-2 text-[32px] font-medium leading-[1.2] text-n100 sm:text-[44px] lg:text-[64px]">
        $1.5M<span class="text-accent">+</span>
      </div>
      <div class="text-2xl text-n600">Invested in arts and culture</div>
    </div>
    <div>
      <div class="mb-2 text-[32px] font-medium leading-[1.2] text-n100 sm:text-[44px] lg:text-[64px]">
        50,000<span class="text-accent">+</span>
      </div>
      <div class="text-2xl text-n600">Event attendees</div>
    </div>
    <div>
      <div class="mb-2 text-[32px] font-medium leading-[1.2] text-n100 sm:text-[44px] lg:text-[64px]">
        $2.0M<span class="text-accent">+</span>
      </div>
