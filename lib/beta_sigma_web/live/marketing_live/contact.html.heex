<!-- ======================= HERO + CONTACT FORM ======================= -->
<section class="mx-auto w-full max-w-[1290px] px-5">
  <div class="grid gap-16 border-b border-n600/40 pb-24 pt-16 lg:grid-cols-2 lg:gap-24">
    <div class="max-w-[477px]">
      <h1 class="mb-4 text-[44px] font-medium leading-[1.15] text-n100 sm:text-[64px] lg:text-[80px]">
        Partner With Us
      </h1>
      <p class="mb-7 text-[18px] leading-[1.667]">
        We're always looking to collaborate with investors, corporates,
        entrepreneurs and strategic partners who share our vision of
        building scalable businesses
        <span class="whitespace-nowrap">across Africa.</span>
      </p>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="mailto:contact@becorp.co.ke" class="flex items-center gap-3 text-xl text-n100 transition-colors hover:text-accent">
          <svg class="h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" />
          </svg>
          contact@becorp.co.ke
        </a>
        <div class="hidden h-6 w-px bg-n600 sm:block"></div>
        <a href="tel:+19142145408" class="flex items-center gap-3 text-xl text-n100 transition-colors hover:text-accent">
          <svg class="h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.9.35 1.78.66 2.63a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.45-1.23a2 2 0 012.11-.45c.85.31 1.73.53 2.63.66A2 2 0 0122 16.92z" />
          </svg>
          (914) - 214 5408
        </a>
      </div>

      <div class="my-10 h-px w-full bg-n600/40"></div>

      <div class="flex items-center gap-6">
        <a href="https://facebook.com/" target="_blank" rel="noopener" class="text-n100 hover:text-accent" aria-label="Facebook">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
          </svg>
        </a>
        <a href="https://twitter.com/" target="_blank" rel="noopener" class="text-n100 hover:text-accent" aria-label="Twitter">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z" />
          </svg>
        </a>
        <a href="https://www.instagram.com/" target="_blank" rel="noopener" class="text-n100 hover:text-accent" aria-label="Instagram">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" /><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
          </svg>
        </a>
        <a href="https://www.linkedin.com/" target="_blank" rel="noopener" class="text-n100 hover:text-accent" aria-label="LinkedIn">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" />
          </svg>
        </a>
        <a href="http://youtube.com/" target="_blank" rel="noopener" class="text-n100 hover:text-accent" aria-label="YouTube">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22.54 6.42a2.78 2.78 0 00-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 00-1.94 2A29 29 0 001 11.75a29 29 0 00.46 5.33A2.78 2.78 0 003.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 001.94-2 29 29 0 00.46-5.25 29 29 0 00-.46-5.33z" />
            <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" />
          </svg>
        </a>
      </div>
    </div>

    <div class="w-full max-w-[546px] border border-white/10 bg-n800 p-8 lg:p-10">
      <.form for={@contact_form} phx-submit="submit_contact" class="space-y-8">
        <div>
          <label for={@contact_form[:name].id} class="sr-only">Name</label>
          <input
            id={@contact_form[:name].id}
            name={@contact_form[:name].name}
            value={@contact_form[:name].value}
            type="text"
            maxlength="256"
            required
            placeholder="What's your name?"
            class="w-full border-b border-n600 bg-transparent py-4 text-n100 placeholder:text-n600 focus:border-accent focus:outline-none"
          />
        </div>
        <div>
          <label for={@contact_form[:email].id} class="sr-only">Email</label>
          <input
            id={@contact_form[:email].id}
            name={@contact_form[:email].name}
            value={@contact_form[:email].value}
            type="email"
            maxlength="256"
            required
            placeholder="What's your email?"
            class="w-full border-b border-n600 bg-transparent py-4 text-n100 placeholder:text-n600 focus:border-accent focus:outline-none"
          />
        </div>
        <div>
          <label for={@contact_form[:company].id} class="sr-only">Company</label>
          <input
            id={@contact_form[:company].id}
            name={@contact_form[:company].name}
            value={@contact_form[:company].value}
            type="text"
            maxlength="256"
            required
            placeholder="What's your company?"
            class="w-full border-b border-n600 bg-transparent py-4 text-n100 placeholder:text-n600 focus:border-accent focus:outline-none"
          />
        </div>
        <div>
          <label for={@contact_form[:message].id} class="sr-only">Leave us a message</label>
          <textarea
            id={@contact_form[:message].id}
            name={@contact_form[:message].name}
            rows="4"
            maxlength="5000"
            required
            placeholder="Enter your message here..."
            class="w-full resize-y border-b border-n600 bg-transparent py-4 text-n100 placeholder:text-n600 focus:border-accent focus:outline-none"
          >{@contact_form[:message].value}</textarea>
        </div>
        <button
          type="submit"
          class="group inline-flex items-center gap-2 border-b border-n100 pb-2 text-2xl font-semibold text-n100 transition-colors hover:border-accent hover:text-accent"
        >
          Send Message
          <svg class="h-6 w-6 shrink-0 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
          </svg>
        </button>
      </.form>
    </div>
  </div>
</section>

<!-- ========================= OUR LOCATIONS ========================= -->
<section class="mx-auto w-full max-w-[1290px] px-5">
  <div class="border-b border-n600/40 py-24 lg:py-32">
    <div class="mx-auto mb-16 max-w-[475px] text-center">
      <h2 class="mb-4 text-[32px] font-medium leading-[1.2] text-n100 sm:text-[44px] lg:text-[64px]">
        Where we operate
      </h2>
      <p class="text-[18px] leading-[1.667]">
        Our companies build and operate across Kenya and
        <span class="whitespace-nowrap">East Africa.</span>
      </p>
    </div>

    <!-- CSS-only carousel: native scroll-snap, swipe on touch, arrows are anchor links -->
    <div class="flex snap-x snap-mandatory gap-10 overflow-x-auto scroll-smooth pb-8 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <article id="office-nairobi" class="w-full shrink-0 snap-center border border-white/10 p-8 lg:p-10">
        <div class="grid gap-10 lg:grid-cols-[440px_auto]">
          <div class="overflow-hidden">
            <img
              src="https://images.unsplash.com/photo-1501594907352-04cda38ebc29?w=1080&q=80"
              alt="Nairobi"
              loading="lazy"
              class="h-full min-h-[280px] w-full object-cover"
            />
          </div>
          <div>
            <h3 class="mb-8 text-[26px] font-medium leading-[1.28] text-n100 lg:text-[50px]">Nairobi</h3>
            <div class="mb-10 flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" />
              </svg>
              <div>
                <div class="text-base uppercase tracking-[0.1em] text-n600">Address</div>
                <div class="text-lg text-n100">Group head office, Nairobi, Kenya</div>
              </div>
            </div>
            <div class="mb-10 flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" />
              </svg>
              <div>
                <div class="text-base uppercase tracking-[0.1em] text-n600">Email</div>
                <a href="mailto:nairobi@becorp.co.ke" class="text-lg text-n100 hover:text-accent">nairobi@becorp.co.ke</a>
              </div>
            </div>
            <a
              href="https://goo.gl/maps/TqZqeqf24wEDiEE47"
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center gap-2 border-b border-n100 pb-2 text-lg font-semibold text-n100 transition-colors hover:border-accent hover:text-accent"
            >
              Visit office
              <svg class="h-5 w-5 shrink-0 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </div>
        </div>
      </article>

      <article id="office-naivasha" class="w-full shrink-0 snap-center border border-white/10 p-8 lg:p-10">
        <div class="grid gap-10 lg:grid-cols-[440px_auto]">
          <div class="overflow-hidden">
            <img
              src="https://images.unsplash.com/photo-1496442226666-8d4d0e62e6e9?w=1080&q=80"
              alt="Naivasha"
              loading="lazy"
              class="h-full min-h-[280px] w-full object-cover"
            />
          </div>
          <div>
            <h3 class="mb-8 text-[26px] font-medium leading-[1.28] text-n100 lg:text-[50px]">Naivasha</h3>
            <div class="mb-10 flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" />
              </svg>
              <div>
                <div class="text-base uppercase tracking-[0.1em] text-n600">Address</div>
                <div class="text-lg text-n100">Chasing Sun farms, Naivasha, Kenya</div>
              </div>
            </div>
            <div class="mb-10 flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" />
              </svg>
              <div>
                <div class="text-base uppercase tracking-[0.1em] text-n600">Email</div>
                <a href="mailto:naivasha@becorp.co.ke" class="text-lg text-n100 hover:text-accent">naivasha@becorp.co.ke</a>
              </div>
            </div>
            <a
              href="https://goo.gl/maps/Z6tHY6rRZcbWRDqM8"
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center gap-2 border-b border-n100 pb-2 text-lg font-semibold text-n100 transition-colors hover:border-accent hover:text-accent"
            >
              Visit office
              <svg class="h-5 w-5 shrink-0 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </div>
        </div>
      </article>
    </div>

    <div class="flex items-center gap-4">
      <a
        href="#office-nairobi"
        aria-label="Show the Nairobi office"
        class="flex h-12 w-12 items-center justify-center border border-white/20 text-n100 transition-colors hover:border-accent hover:text-accent"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6" />
        </svg>
      </a>
      <a
        href="#office-naivasha"
        aria-label="Show the Naivasha office"
        class="flex h-12 w-12 items-center justify-center border border-white/20 text-n100 transition-colors hover:border-accent hover:text-accent"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </a>
    </div>
  </div>
</section>

<!-- ============================== FAQ ============================== -->
<section class="mx-auto w-full max-w-[1290px] px-5">
  <div class="py-24 lg:py-32">
    <div class="mx-auto mb-16 max-w-[860px] text-center">
      <h2 class="mb-4 text-[32px] font-medium leading-[1.2] text-n100 sm:text-[44px] lg:text-[64px]">
        Frequently asked questions
      </h2>
      <p class="mx-auto max-w-[748px] text-[18px] leading-[1.667]">
        How BeCorp builds, scales and manages high-growth businesses
        across strategic sectors — and how investors, corporates,
        entrepreneurs and strategic partners can
        <span class="whitespace-nowrap">work with us.</span>
      </p>
    </div>

    <!-- Native <details> accordion -->
    <div class="mx-auto max-w-[860px] divide-y divide-n600/40">
      <details class="group py-8" open>
        <summary class="flex cursor-pointer list-none items-start gap-6 [&::-webkit-details-marker]:hidden">
          <span class="text-[26px] font-medium leading-none text-accent lg:text-[50px]">01</span>
          <h3 class="flex-1 text-xl font-medium text-n100 lg:text-[30px]">What does BeCorp do?</h3>
          <svg class="mt-2 h-6 w-6 shrink-0 text-n100 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
          </svg>
        </summary>
        <p class="mt-6 pl-0 text-[18px] leading-[1.667] sm:pl-[86px] lg:pl-[110px]">
          BeCorp is a diversified investment and operating company that
          builds, scales and manages high-growth businesses across
          strategic sectors. Through innovation, disciplined execution and
          long-term partnerships, we develop businesses that create
          lasting economic and social impact
          <span class="whitespace-nowrap">across Africa.</span>
        </p>
      </details>

      <details class="group py-8">
        <summary class="flex cursor-pointer list-none items-start gap-6 [&::-webkit-details-marker]:hidden">
          <span class="text-[26px] font-medium leading-none text-accent lg:text-[50px]">02</span>
          <h3 class="flex-1 text-xl font-medium text-n100 lg:text-[30px]">Which companies are in the Group?</h3>
          <svg class="mt-2 h-6 w-6 shrink-0 text-n100 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
          </svg>
        </summary>
        <p class="mt-6 pl-0 text-[18px] leading-[1.667] sm:pl-[86px] lg:pl-[110px]">
          The portfolio spans Tukutane Entertainment, Chasing Sun
          Agriculture, SandCorp and Sichangi Law Alliance (SLA) — covering
          entertainment, agriculture, real estate and
          <span class="whitespace-nowrap">professional services.</span>
        </p>
      </details>

      <details class="group py-8">
        <summary class="flex cursor-pointer list-none items-start gap-6 [&::-webkit-details-marker]:hidden">
          <span class="text-[26px] font-medium leading-none text-accent lg:text-[50px]">03</span>
          <h3 class="flex-1 text-xl font-medium text-n100 lg:text-[30px]">How does the Group work with each company?</h3>
          <svg class="mt-2 h-6 w-6 shrink-0 text-n100 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
          </svg>
        </summary>
        <p class="mt-6 pl-0 text-[18px] leading-[1.667] sm:pl-[86px] lg:pl-[110px]">
          Each company operates independently while benefiting from the
          Group's strategic leadership, governance and shared
          capabilities. Through shared expertise and disciplined
          execution, we enable each subsidiary to scale sustainably while
          creating long-term value for
          <span class="whitespace-nowrap">stakeholders.</span>
        </p>
      </details>

      <details class="group py-8">
        <summary class="flex cursor-pointer list-none items-start gap-6 [&::-webkit-details-marker]:hidden">
          <span class="text-[26px] font-medium leading-none text-accent lg:text-[50px]">04</span>
          <h3 class="flex-1 text-xl font-medium text-n100 lg:text-[30px]">Are you open for partnership?</h3>
          <svg class="mt-2 h-6 w-6 shrink-0 text-n100 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
          </svg>
        </summary>
        <p class="mt-6 pl-0 text-[18px] leading-[1.667] sm:pl-[86px] lg:pl-[110px]">
          Yes. We're always looking to collaborate with investors,
          corporates, entrepreneurs and strategic partners who share our
          vision of building scalable businesses
          <span class="whitespace-nowrap">across Africa.</span>
        </p>
      </details>
    </div>
  </div>
</section>
