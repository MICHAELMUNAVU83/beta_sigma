<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title
      default="BeCorp"
      prefix={chat_title_prefix(assigns)}
      suffix=" · Building Businesses That Shape Africa's Future"
    >
      {assigns[:page_title]}
    </.live_title>

    <%!-- SEO Meta Tags --%>
    <meta
      name="description"
      content="BeCorp — Custom software development, AI integration, and business automation. We design and build web platforms, mobile apps, and internal tools for businesses across Africa."
    />
    <meta
      name="keywords"
      content="BeCorp, software development, web systems, AI integration, business automation, mobile apps, ERP, Nairobi, Kenya, technology"
    />
    <link rel="canonical" href="https://www.becorp.co.ke" />

    <%!-- Open Graph / Facebook --%>
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.becorp.co.ke" />
    <meta property="og:title" content="BeCorp — Building Businesses That Shape Africa's Future" />
    <meta
      property="og:description"
      content="Custom software, web platforms, and AI-powered tools for businesses across Africa and beyond."
    />
    <link id="app-favicon" rel="icon" type="image/png" href={~p"/images/becorp-logo.png"} />
    <meta property="og:image" content="https://www.becorp.co.ke/images/becorp-logo.png" />

    <%!-- Twitter --%>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://www.becorp.co.ke" />
    <meta name="twitter:title" content="BeCorp — Building Businesses That Shape Africa's Future" />
    <meta
      name="twitter:description"
      content="Custom software, web platforms, and AI-powered tools for businesses across Africa and beyond."
    />
    <meta name="twitter:image" content="https://www.becorp.co.ke/images/becorp-logo.png" />

    <script src="https://cdn.jsdelivr.net/npm/chart.js">
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="min-h-screen bg-stone-100 text-slate-950 antialiased">
    {@inner_content}
  </body>
</html>
