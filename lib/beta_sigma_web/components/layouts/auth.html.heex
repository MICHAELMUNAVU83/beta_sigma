<div class="flex min-h-screen items-center justify-center bg-[radial-gradient(circle_at_top,_rgba(23,23,23,0.12),_transparent_35%),linear-gradient(180deg,_#ffffff_0%,_#f5f5f5_100%)] px-4 py-10 sm:px-6 lg:px-8">
  <div class="w-full max-w-md rounded-[2rem] border border-stone-200 bg-white p-8 shadow-xl shadow-slate-300/20">
    <div class="mb-8 text-center">
      <.link href={~p"/"} class="text-xs font-semibold uppercase tracking-[0.3em] text-orange-600">
        BetaSigma
      </.link>
      <p class="mt-3 text-sm text-slate-500">Authentication and account recovery</p>
    </div>

    <.flash_group flash={@flash} />

    {@inner_content}
  </div>
</div>
