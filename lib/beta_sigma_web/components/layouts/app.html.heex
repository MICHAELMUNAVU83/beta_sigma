<div id="app-shell" class="min-h-screen overflow-x-hidden bg-n800 font-becorp text-n500">
  <.app_sidebar
    current_user={@current_user}
    unread_count={assigns[:unread_count] || 0}
    chat_unread_count={assigns[:chat_unread_count] || 0}
    current_view={assigns[:socket] && @socket.view}
    live_action={assigns[:live_action]}
  />

  <div
    id="app-main-shell"
    class="flex min-h-screen min-w-0 flex-1 flex-col transition-[padding] duration-300 lg:pl-72"
  >
    <header class="h-[53px] border-b border-white/10 bg-ink px-4 sm:px-6 lg:px-8">
      <div class="flex h-full items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <button
            phx-click={BetaSigmaWeb.SidebarComponent.open_mobile_sidebar()}
            class="inline-flex border border-white/10 p-1.5 text-n600 transition hover:border-accent hover:text-accent lg:hidden"
            aria-label="Open navigation"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>

          <p class="text-sm font-medium text-n600">BetaSigma</p>
        </div>

        <div class="flex items-center gap-2">
          <.link
            :if={is_integer(assigns[:unread_count])}
            navigate={~p"/app/notifications"}
            class="px-2 py-1 text-xs font-medium text-red-500 transition hover:bg-red-500/10"
          >
            {assigns[:unread_count]} unread
          </.link>
          <span class="hidden text-sm text-n500 sm:inline">
            {display_name(@current_user)}
          </span>
          <.form action={~p"/users/log_out"} method="delete">
            <button
              type="submit"
              class="border border-white/20 px-3 py-1 text-xs font-medium text-n100 transition hover:border-accent hover:text-accent"
            >
              Log out
            </button>
          </.form>
        </div>
      </div>
    </header>

    <main class="flex-1 pb-8 min-w-0 px-4 sm:px-6 lg:px-8">
      <div
        id="app-workspace-shell"
        class="mx-auto w-full pt-6 min-w-0 space-y-6 transition-[max-width] duration-300"
      >
        <.flash_group flash={@flash} />
        {@inner_content}
      </div>
    </main>
  </div>
</div>
