<main class="min-h-screen bg-stone-100 px-4 py-16 text-slate-950 sm:px-6 lg:px-8">
  <div class="mx-auto w-full max-w-2xl">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-orange-700">
      BetaSigma
    </p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950">Page not found</h1>
    <p class="mt-3 text-sm leading-6 text-slate-600">
      The page you’re looking for doesn’t exist or may have moved.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <.link
        navigate={~p"/app/projects"}
        class="rounded-full bg-[#102033] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[#1f3a4c]"
      >
        Go to dashboard
      </.link>
      <.link
        navigate={~p"/"}
        class="rounded-full border border-stone-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-stone-50"
      >
        Back to home
      </.link>
    </div>

    <div class="mt-10 rounded-[1.75rem] border border-stone-200 bg-white/90 p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] backdrop-blur-sm">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Tip</p>
      <p class="mt-2 text-sm leading-6 text-slate-600">
        If you typed the URL manually, check the spelling. If you came from a link inside the app,
        please report it to an admin.
      </p>
    </div>
  </div>
</main>
